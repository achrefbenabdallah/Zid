rules_version = '2';

// Zid — every document lives under users/{uid}/… and only that user can touch it.
// Deploy: Firebase console → Firestore → Rules → paste this file → Publish
//     or: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function nonNeg(v) {
      return (v is int || v is float) && v >= 0;
    }

    function validMacros(m) {
      return nonNeg(m.kcal) && nonNeg(m.protein) && nonNeg(m.carbs) && nonNeg(m.fat);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.goals is map
        && request.resource.data.language in ['en', 'ar'];

      match /foods/{foodId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && validMacros(request.resource.data.per100g);
      }

      match /mealEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() <= 120
          && nonNeg(request.resource.data.grams)
          && validMacros(request.resource.data);
      }

      // Meal thumbnails (small data URLs) — stored here instead of Cloud Storage (free plan).
      match /mealPhotos/{photoId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.thumb is string
          && request.resource.data.thumb.size() < 200000;
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 50;
      }

      match /exerciseRecords/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /weightLogs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && nonNeg(request.resource.data.kg);
      }

      match /days/{date} {
        allow read, write: if isOwner(uid) && isDateKey(date);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

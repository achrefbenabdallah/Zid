rules_version = '2';

// Zid — every document lives under users/{uid}/… and only that user can touch it.
// Deploy: Firebase console → Firestore → Rules → paste this file → Publish
//     or: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isDateKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function nonNeg(v) {
      return (v is int || v is float) && v >= 0;
    }

    function validMacros(m) {
      return nonNeg(m.kcal) && nonNeg(m.protein) && nonNeg(m.carbs) && nonNeg(m.fat);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.goals is map
        && request.resource.data.language in ['en', 'ar'];

      match /foods/{foodId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && validMacros(request.resource.data.per100g);
      }

      match /mealEntries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.foodName is string
          && request.resource.data.foodName.size() <= 120
          && nonNeg(request.resource.data.grams)
          && validMacros(request.resource.data);
      }

      // Meal thumbnails (small data URLs) — stored here instead of Cloud Storage (free plan).
      match /mealPhotos/{photoId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.thumb is string
          && request.resource.data.thumb.size() < 200000;
      }

      match /workouts/{workoutId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 50;
      }

      // Exercises the user created (name, muscle group, optional how-to + small photo).
      match /customExercises/{exId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.group in ['chest', 'back', 'shoulders', 'biceps', 'triceps', 'forearms',
               'quadriceps', 'hamstrings', 'glutes', 'calves', 'abs', 'adductors', 'traps']
          && (!('howTo' in request.resource.data) || (request.resource.data.howTo is string && request.resource.data.howTo.size() <= 1000))
          && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() < 200000));
      }

      // Reusable sessions ("Jambes", "Push"…) with per-exercise progression settings.
      match /templates/{templateId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() <= 30;
      }

      match /exerciseRecords/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /weightLogs/{logId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isDateKey(request.resource.data.date)
          && nonNeg(request.resource.data.kg);
      }

      // Read is unconditional for the owner: list queries (streaks, charts) can't evaluate
      // conditions on the document id, so the date-format check applies to writes only.
      match /days/{date} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && isDateKey(date);
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
